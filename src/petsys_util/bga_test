def merge_failures(a, b):
	c = {}
	for k in a.keys():
		c[k] = a[k]
		if b.has_key(k):
			a[k] += b[k]
	
	return c

def log(f, s):
	print s


def trim_bg(conn, tester, p, s, m, a):
	trim_options = { 
		7       : -12.28E-3,
		6       : -12.32E-3,
		5       : -12.34E-3,
		4       : +19.27E-3,
		3       : +9.73E-3,
		2       : +4.89E-3,
		1       : +2.49E-3,
		0       : +1.25E-3,
		None    : 0
	}

	target = 0.300
	
	portID = p
	slaveID = s
	busID = m
	chipID = a
	readID = 2*m + a
	output_file = None
	
	tester.set_uut_vfuse(True)
	value = tester.get_uut_vbg(a)
	
	
	log(output_file, "INITIAL VALUE: %1.5f" % value)
	while abs(value - target) > 1E-3:
		selected_option = None
		expected_voltage = value + 1E6
		selected_option_error = abs(value - target)
		
		for option, delta in trim_options.items():

			# If current value is above target + 4 mV, consider only negative trim options
			if (value > (target + 4e-3)) and (delta >= 0): continue
			
			option_error = abs(value + delta - target)
			if option_error < selected_option_error:
				selected_option_error = option_error
				selected_option = option
				expected_voltage = value + delta
		
		if selected_option is None: break
		
		log(output_file, "SELECTED %d (%1.5f), EXPECT %1.5f" % (selected_option, trim_options[selected_option], expected_voltage))
		gc = tofhir2b.AsicGlobalConfig()
		gc.setValue("EFUSE_A", selected_option)
		conn._Connection__tofhir2_cmd(portID, slaveID, busID, chipID, readID, 32, True, False, gc)              
		
		#answer = input("Proceed? (Y/N)")
		#if answer.lower() != 'y':
			#break
		
		del trim_options[selected_option]
		
		
		# Trim
		conn._Connection__tofhir2_cmd(portID, slaveID, busID, chipID, readID, 37, True, False, bitarray.bitarray(160))
		time.sleep(0.1)
		
		# Load
		conn._Connection__tofhir2_cmd(portID, slaveID, busID, chipID, readID, 35, True, False, bitarray.bitarray(254))
		time.sleep(0.1)
		conn._Connection__tofhir2_cmd(portID, slaveID, busID, chipID, readID, 36, True, False, bitarray.bitarray(254))
		time.sleep(0.1)

		value = tester.get_uut_vbg(a)
		log(output_file, "NEW VALUE. %1.5f" % value)

	tester.set_uut_vfuse(False)

	return abs(value - target) < 5E-3


def check_trim(sockets):
	results = {}
	for tester, p, s, m, a in sockets:
		results[(tester, p, s, m, a)] = []
		v = tester.get_uut_vbg(a)
		if abs(v - 0.300) > 5E-3:
			results[(tester, p, s, m, a)].append("BANDGAP %5.3f OUT OF RANGE" % v)

	return results


	
	
def acquire_extp(conn, sockets, ddir, att):
	print "TESTING: EXTP"
	asicsConfig0 = conn.getAsicsConfig()
	conn.setTestPulsePLL(500, 10240, 0.0)
	
	fName = "%s/extp_scan" % ddir
	conn.openRawAcquisition(fName)

	for ch in range(32):
		#for dac in range(0x8000, 0x10000, 0x8000/32):
		for dac in [ 0xFFFF ]:
			for t, p, s, m, a in sockets:
				t.injector_enable(ch, dac)
				
			time.sleep(0.5)

			for ith in range(30, 64):
				asicsConfig = deepcopy(asicsConfig0)

				for ac in asicsConfig.values():
					cc = ac.channelConfig[ch]
					cc.setValue("cfg_a3_range_t1", 3)
					cc.setValue("c_tgr_main", 0b00)
					cc.setValue("c_tgr_t1", 0)
					cc.setValue("c_tgr_q", 0)
					cc.setValue("c_tgr_t2", 0)
					cc.setValue("c_tgr_q", 0)
					cc.setValue("c_tgr_v", 0)
					cc.setValue("cfg_a3_ith_t1", 48)
					cc.setValue("cfg_a3_ith_t1", ith)
					cc.setValue("cfg_a2_dcr_delay_t", 0b11111111)
					cc.setValue("cfg_a2_dcr_delay_e", 0b0111111)
					cc.setValue("c_min_q", 2)
					cc.setValue("c_max_q", 2)
					cc.setValue("cfg_a2_attenuator_gain", att)
					
				conn.setAsicsConfig(asicsConfig)
				
				conn.acquire(0.1, dac, ith)
	conn.closeAcquisition()
	
	# Disable stuf and return to normal
	conn.setAsicsConfig(asicsConfig0)
	for t, p, s, m, a in sockets:
		t.injector_disable()


def check_extp(sockets, ddir, att):	
	os.system("./convert_raw_to_singles --config %(ddir)s/config.ini -i %(ddir)s/extp_scan -o %(ddir)s/extp_scan.root --writeRoot --att %(att)d" % locals())

	fName = "%s/extp" % ddir	
	os.system("""root -b -l -q plot_fetp_calibration.cc+\\(\\"%(fName)s\\",30\\)""" % locals())
	
	df = pd.read_csv("%(ddir)s/extp.tsv" % locals(), sep="\t", header=None, names=["asic_id", "channel_id", "amplitude", "trms", "emean", "erms"])
	
	results = {}
	for t, p, s, m, a in sockets:
		results[(t,p,s,m,a)] = []
		for ch in range(32):
			asic_id = 2*m + a
			
			df2 = df[(df["asic_id"] == asic_id) & (df["channel_id"] == ch)]
			
			try:
				trms = df2["trms"].iloc[0]
				
				if trms == 0:
					results[(t,p,s,m,a)].append("EXTP CH %d LOW COUNTS" % ch)
					continue
					
				if trms > 50:
					results[(t,p,s,m,a)].append("EXTP CH %d TRMS %4.1f > 50 ps" % (ch, trms))
					continue

				erms = df2["erms"].iloc[0]
				if erms > 50:
					results[(t,p,s,m,a)].append("EXTP CH %d ERMS %4.1f > 50" % (ch, erms))
					continue
				
				
				
			except IndexError as e:
				results[(t,p,s,m,a)].append("EXTP CH %d MISSING" % ch)
				continue
				
		
	return results
	
