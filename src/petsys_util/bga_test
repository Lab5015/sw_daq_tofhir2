def acquire_aldo(conn, sockets, d):
	print "TESTING: ALDO"
	asicsConfig0 = conn.getAsicsConfig()
	
	f = open("%s/aldo.tsv" % d, "w")
	
	for aldo_range in [0, 1]:
		for aldo_dac in [ x for x in range(0, 256, 7)] + [ 255]:
			sys.stdout.write(".")
			sys.stdout.flush()
			
			asicsConfig = deepcopy(asicsConfig0)
			for ac in asicsConfig.values():
				gc = ac.globalConfig
				if aldo_range == 0:
					gc.setValue("Valdo_A_Gain", 0)
					gc.setValue("Valdo_B_Gain", 0)
					gc.setValue("c_aldo_range", 0b00)
				else:
					gc.setValue("Valdo_A_Gain", 1)
					gc.setValue("Valdo_B_Gain", 1)
					gc.setValue("c_aldo_range", 0b11)
				
				gc.setValue("Valdo_A_DAC", aldo_dac)
				gc.setValue("Valdo_B_DAC", aldo_dac)
				
				
			conn.setAsicsConfig(asicsConfig)
			
			for t, p, s, m, a in sockets:
				v = t.get_uut_valdo(a, 0)
				f.write("%d\t%d\t%d\t%d\t%d\t%d\t%d\t%f\n" % (p, s, m, a, 0, aldo_range, aldo_dac, v))
				v = t.get_uut_valdo(a, 1)
				f.write("%d\t%d\t%d\t%d\t%d\t%d\t%d\t%f\n" % (p, s, m, a, 1, aldo_range, aldo_dac, v))
	    
	
	sys.stdout.write("\n")
	f.close()
	conn.setAsicsConfig(asicsConfig0)
	return True
	
def check_aldo(sockets, ddir):	
	df = pd.read_csv("%(ddir)s/aldo.tsv" % locals(), sep="\t", header=None, 
			names=["port_id", "slave_id", "module_id", "asic_id", "aldo_id", 
				"aldo_gain", "aldo_dac", "vout" ])

	results = {}			
	for t, p, s, m, a in sockets:
		results[(t,p,s,m,a)] = []
		for aldo_id in range(2):
			for aldo_gain in range(2):
				df2 = df[(df["module_id"] == m) & (df["asic_id"] == a) & (df["aldo_id"] == aldo_id) & (df["aldo_gain"] == aldo_gain)]
				
				# Exlude top 20% of range
				df2 = df2[df2["aldo_dac"] < 200]
				
				aldo_dac = df2["aldo_dac"]
				vout = df2["vout"]
				
				
				lower = min(vout)
				upper = max(vout)
				slope, b = np.polyfit(aldo_dac, vout, 1)
				
				error = vout - (slope * aldo_dac + b)
				
				if aldo_gain == 0:
					if (lower < 0.820) or (upper > 1.0):
						results[(t,p,s,m,a)].append("ALDO %(aldo_id)d GAIN %(aldo_gain)d RANGE %(lower)5.3f .. %(upper)5.3f OUT OF BOUNDS" % locals())
						continue
						
				else:
					if (lower < 0.730) or (upper > 1.0):
						results[(t,p,s,m,a)].append("ALDO %(aldo_id)d GAIN %(aldo_gain)d RANGE %(lower)5.3f .. %(upper)5.3f OUT OF BOUNDS" % locals())
						continue
				
						
				max_inl = max(abs(error)) / slope
				if max_inl > 10:
					results[(t,p,s,m,a)].append("ALDO %(aldo_id)d GAIN %(aldo_gain)d MAX INL %(max_inl)4.1f > 10" % locals())
					continue
					
	return results


def check_discriminators(sockets, ddir):	
	os.system("./process_threshold_calibration --config %(ddir)s/config.ini -i %(ddir)s/disc_calibration -o %(ddir)s/disc_calibration.tsv" % locals())
	
	df = pd.read_csv("%(ddir)s/disc_calibration.tsv" % locals(), sep="\t", header=None, comment="#",
		names=["port_id", "slave_id", "asic_id", "channel_id", 	"baseline_T", "baseline_E", "zero_T1", "zero_T2", "zero_E", "noise_T1", "noise_T2", "noise_E"]
		)
	
	results = {}
	for t, p, s, m, a in sockets:
		results[(t,p,s,m,a)] = []
		for ch in range(32):
			asic_id = 2*m + a
			
			df2 = df[(df["asic_id"] == asic_id) & (df["channel_id"] == ch)]
			
			try:
				v = df2["noise_T1"].iloc[0]					
				if v > 0.8:
					results[(t,p,s,m,a)].append("DISC CH %d NOISE T1 %4.1f > 0.8" % (ch, v))
					continue
			
				v = df2["noise_T2"].iloc[0]					
				if v > 0.8:
					results[(t,p,s,m,a)].append("DISC CH %d NOISE T2 %4.1f > 0.8" % (ch, v))
					continue
				v = df2["noise_E"].iloc[0]					
				if v > 2.0:
					results[(t,p,s,m,a)].append("DISC CH %d NOISE E %4.1f > 0.8" % (ch, v))
					continue
				
				
			except IndexError as e:
				results[(t,p,s,m,a)].append("DISC CH %d MISSING" % ch)
				continue
	
	#print results
	return results
	
	
